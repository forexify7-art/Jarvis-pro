{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J.A.R.V.I.S.",
  "version": "1.0.0",
  "identifier": "com.jarvisbykhan.assistant",
  "build": {
    "frontendDist": "./frontend-dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "node --env-file-if-exists=.env server.js",
    "beforeBuildCommand": "npm run build:avatar && node scripts/prepare-tauri-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "J.A.R.V.I.S.",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
