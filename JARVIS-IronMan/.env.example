AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
AI_MODEL=gemini-3.8-flash

# Optional when exposing this server beyond localhost.
# APP_ACCESS_TOKEN=replace_with_a_long_random_value

# Optional natural voice (OmniVoice sidecar, see START_HERE.md). Defaults shown.
# OMNIVOICE_URL=http://127.0.0.1:4175

# Optional Home Assistant integration. Use a dedicated, revocable token.
# Status reads are limited to listed sensor, binary_sensor, light, and switch entities.
# Device controls are disabled unless an additional light/switch allowlist is configured.
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=replace_with_a_dedicated_long_lived_access_token
# HOME_ASSISTANT_ENTITIES=sensor.living_room_temperature,light.office
# HOME_ASSISTANT_CONTROL_ENTITIES=light.office

# Optional Gmail draft and Google Calendar integration. Configure a Google OAuth Web client,
# enable Gmail API and Google Calendar API, and allow this exact redirect URI in Google Cloud.
# Scope is limited to Gmail compose and owned Calendar events; this app never sends email.
# GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
# GOOGLE_REDIRECT_URI=https://your-host.example/api/google/callback
# Generate once with: openssl rand -base64 32. Keep this key stable and private.
# APP_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key
# Optional persistent path; defaults to .data/google-workspace.tokens.enc.
# GOOGLE_TOKEN_FILE=.data/google-workspace.tokens.enc

# Optional Telegram Bot API integration. Create a bot with @BotFather and use
# only numeric private/group chat IDs that the server administrator approves.
# TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1009876543210

# Optional Facebook Messenger Platform integration. Use a Meta-supported Graph API version.
# FACEBOOK_PAGE_ID=your_facebook_page_id
# FACEBOOK_PAGE_ACCESS_TOKEN=replace_with_page_access_token
# FACEBOOK_GRAPH_API_VERSION=replace_with_a_supported_version
# FACEBOOK_ALLOWED_RECIPIENT_IDS=123456789012345

# Packaged apps (Tauri Android/Windows) talk to this server from another origin.
# tauri://localhost and http(s)://tauri.localhost are always allowed; add more here, comma-separated.
# ALLOWED_ORIGINS=https://my-pwa.example.com

# Set to 1 ONLY when running behind a trusted reverse proxy (Render, Nginx) so rate limits are per visitor.
# TRUST_PROXY=1
